81,"y1":-9.389999999999999},{"t":"b","x0":-18.9,"x1":-16.9,"y0":-1.0,"y1":1.0},{"t":"b","x0":-17.0,"x1":-15.7,"y0":-1.35,"y1":1.35},{"t":"b","x0":-15.149999999999999,"x1":-14.649999999999999,"y0":-0.8,"y1":0.8},{"t":"c","x":-17.7,"y":-2.6,"r":0.28},{"t":"c","x":-17.7,"y":2.6,"r":0.28},{"t":"b","x0":15.799999999999999,"x1":17.0,"y0":-1.0,"y1":1.0},{"t":"b","x0":15.239999999999998,"x1":15.66,"y0":-0.21,"y1":0.21},{"t":"b","x0":17.139999999999997,"x1":17.56,"y0":-0.21,"y1":0.21},{"t":"c","x":18.5,"y":-2.9,"r":0.28},{"t":"c","x":18.5,"y":2.9,"r":0.28},{"t":"c","x":11.6,"y":-16.1,"r":1.05},{"t":"c","x":-9.4,"y":-12.9,"r":0.45}],"walk":[{"x0":-12.15,"x1":12.15,"y0":-16.65,"y1":8.7},{"x0":-7.25,"x1":7.25,"y0":8.6,"y1":20.65},{"x0":-4.15,"x1":4.15,"y0":20.6,"y1":24.55},{"x0":12.1,"x1":13.9,"y0":-0.95,"y1":0.95},{"x0":13.85,"x1":18.65,"y0":-3.15,"y1":3.15},{"x0":-13.9,"x1":-12.1,"y0":-0.95,"y1":0.95},{"x0":-18.65,"x1":-13.85,"y0":-3.15,"y1":3.15},{"x0":-1.25,"x1":1.25,"y0":-25.68,"y1":-16.6}],"sq":1.5,"pieces":{"king":1.45,"queen":1.3,"bishop":1.1,"knight":1.02,"rook":0.9,"pawn":0.74},"reads":[{"id":"lintel","p":[0.0,-16.98,4.93],"text":"门已关闭。棋局仍开。","title":"门楣上","r":6},{"id":"law1","p":[-7.515,10.2,2.5],"text":"第一律\n有两只手。其中一只属于你。","title":"律法石板","r":4.5},{"id":"law2","p":[7.515,10.2,2.5],"text":"第二律\n棋局不会结束。它只是被离开。","title":"律法石板","r":4.5},{"id":"law3","p":[12.415,7.3,2.3],"text":"第三律\n败者会被留下。另一只手不断生长。","title":"律法石板","r":4.5},{"id":"shame","p":[-19.715,0.0,1.625],"text":"创始者的耻辱\n在王后所在的直线，第五横排，国王可以躺下。","title":"车的身后","r":5.0},{"id":"ledger","p":[0.0,12.7,0.968],"text":"放下王冠的人，将走入日光。","title":"祭坛前，地面上磨出的字","r":3.0},{"id":"scr1","p":[0.0,-26.068,3.825],"text":"它在我身后合上了。靠着烛火，三十一天。","title":"刻在石上","r":2.6},{"id":"scr2","p":[-12.488,7.1,0.92],"text":"它从不疲倦。它下得像它们所有人同时在下。因为它就是它们全部。","title":"刻在墙脚","r":2.6},{"id":"scr3","p":[18.1,-3.488,1.25],"text":"创始者留了一条路。不是赢。是认输。把国王放下——可放在哪里？","title":"刻在架子旁","r":2.6},{"id":"scr4","p":[-18.1,3.488,0.85],"text":"d5。王后之路，第五格。我现在知道了。我做不到。再来一局。","title":"刻在近地面处","r":2.6},{"id":"scr5","p":[11.412,12.4,2.725],"text":"它只会绕圈。像这局棋。不是墙——是地面。国王要躺下的是真正的地面。","title":"刻在转角","r":1.9},{"id":"crack","p":[14.75,12.0,2.95],"title":"墙上的裂缝","r":1.5,"text":"另一侧一片漆黑。旧蜡烛的气味，还有某种活物的气息。声音在这里非常近。"},{"id":"drop","p":[-10.5,4.9,0.0],"title":"地面上的格栅","r":2.8,"text":"冷风从铁条间升起。看不到底。下面有什么东西，而且非常庞大。"},{"id":"spy","p":[0.95,-26.08,4.1],"title":"封死的门上的窄缝","r":1.4,"text":"一道不超过两指宽的缝。缝隙之外，你下来的那道阶梯并不是唯一的阶梯。"},{"id":"scr6","p":[9.28,8.592,1.305],"text":"一道道计数刻痕，成百上千，排成行。下面写着：谁在执白","title":"刻在格栅旁","r":2.0},{"id":"grate","p":[9.274999999999999,8.6,0.75],"title":"铁格栅","r":1.8,"text":"嵌在角落低处。下面的铁条被一只手握得发亮。另一边有人。"},{"id":"tab_a_w","p":[-10.65,8.5,2.05],"title":"刻在石上的棋局","r":3.2,"text":"一整局棋刻在这里，一步不落，位于骑士的记号之下。第二十三步以将死结束。赢家几乎先送出了所有棋子。"},{"id":"tab_b_e","p":[10.65,8.5,2.05],"title":"刻在石上的棋局","r":3.2,"text":"另一局棋，位于王后的记号之下。十七步。第十六步献出王后，好让车结束这局棋。"},{"id":"study","p":[16.4,0.0,0.85],"title":"书房里的桌子","r":2.4,"text":"一局下到一半被弃置的棋。白王所在的棋格，任何国王都无法走到。有人把它侧放在王后所在的直线，第五横排。"},{"id":"altarset","p":[0,14.6,2.25],"title":"祭坛","r":2.6,"text":"一局以金与黑下完的棋。金方几乎一无所有，却赢了。"},{"id":"heap","p":[10.9,-15.6,0.4],"title":"门边","r":2.8,"text":"破碎的棋子被扫成一堆。黑的与白的混在一起。足够许多局棋。"}],"loop":[{"x0":17.5,"x1":17.9,"y0":3.0,"y1":12.7},{"x0":11.7,"x1":17.9,"y0":12.3,"y1":12.7},{"x0":11.7,"x1":12.1,"y0":8.3,"y1":12.7}],"vistas":{"drop":[-10.5,4.9,0.0],"spy":[0.95,-26.08,4.1],"crack":[14.75,12.0,2.95]},"relief":{"x":13.512,"y0":1.8,"y1":3.0,"z0":0.95,"z1":2.15},"grate":[9.274999999999999,8.6,0.75],"door":{"x":0.0,"y":24.9,"y1":29.9,"z":0.96},"dais":{"y0":8.6,"y1":11.0,"h":0.96},"stairs":{"y0":-18.4,"tread":0.32,"rise":0.18,"n":14},"altar":[0,14.6,0.96],"wells":[[0,0,13.0,1.5],[0,23.0,26.0,2.2]],"assets":{"mobile":{"temple":"m/temple.glb","pieces":"m/pieces.glb","vistas":{"drop":["m/vista_drop.jpg","m/vista_drop_b.jpg","m/vista_drop_c.jpg"],"spy":["m/vista_spy.jpg","m/vista_spy_b.jpg","m/vista_spy_c.jpg"],"cell":"m/vista_cell.jpg"}}}}